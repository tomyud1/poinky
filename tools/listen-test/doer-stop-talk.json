{"about": "Holding the talk keys to say something pauses Poinky doing things for you within one act (here a walkthrough of waits, so nothing on screen is touched).",
 "env": {"FAKE_CLAUDE_REPLY": "<say>On it.</say><do>wait a while</do>",
         "FAKE_GUIDE_REPLIES": "[\"<act>{\\\"do\\\":\\\"wait\\\",\\\"s\\\":0.6}</act><act>{\\\"do\\\":\\\"wait\\\",\\\"s\\\":0.6}</act><act>{\\\"do\\\":\\\"wait\\\",\\\"s\\\":0.6}</act><act>{\\\"do\\\":\\\"wait\\\",\\\"s\\\":0.6}</act><act>{\\\"do\\\":\\\"wait\\\",\\\"s\\\":0.6}</act><act>{\\\"do\\\":\\\"wait\\\",\\\"s\\\":0.6}</act><act>{\\\"do\\\":\\\"wait\\\",\\\"s\\\":0.6}</act><act>{\\\"do\\\":\\\"wait\\\",\\\"s\\\":0.6}</act><act>{\\\"do\\\":\\\"wait\\\",\\\"s\\\":0.6}</act><act>{\\\"do\\\":\\\"wait\\\",\\\"s\\\":0.6}</act>\", \"<done>Done.</done>\"]"},
 "steps": [
  {"at": 1.5, "keys": "down"},
  {"at": 2.2, "words": "do it for me", "final": true},
  {"at": 2.4, "keys": "up"},

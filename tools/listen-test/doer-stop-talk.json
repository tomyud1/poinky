  {"at": 5.6, "words": "wait", "final": true}, {"at": 5.8, "keys": "up"},
  {"at": 4.85, "probe": "acts when you started talking"},
  {"at": 8.5, "probe": "no act started after you started talking", "expect": {"actsAtMost": 5}},
  {"at": 9.0, "quit": true}
 ]}
